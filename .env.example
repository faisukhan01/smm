# ---------------------------------------------------------------------------
# SMM — AI Social Media Manager
# Copy to `.env` and fill in real values. Never commit the filled file.
#
# Deployment model: ONE full-stack Next.js app (frontend + API routes in the
# same deployment, e.g. Vercel). OAuth app credentials (Meta / Pinterest) are
# NOT env vars — they are configured inside the app (Accounts view) and stored
# encrypted in Postgres via APP_ENCRYPTION_KEY.
# ---------------------------------------------------------------------------

# --- Database (Neon PostgreSQL, pooled connection) --------------------------
# Prisma reads POSTGRES_URL.
POSTGRES_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth -------------------------------------------------------------------
# 64+ random chars. Generate: openssl rand -base64 48
APP_JWT_SECRET="change-me-to-a-long-random-string"

# --- Encryption -------------------------------------------------------------
# AES-256-GCM key for OAuth tokens + app credentials at rest (32 bytes).
# Must stay identical across environments — decrypting stored secrets fails
# otherwise. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY="change-me-32-bytes-base64"

# --- Public URL -------------------------------------------------------------
# Canonical https origin, used to build OAuth redirect URIs:
#   {PUBLIC_APP_URL}/api/v1/accounts/oauth/{platform}/callback
# Optional — falls back to the incoming request origin when unset.
PUBLIC_APP_URL="https://your-app.vercel.app"

# --- Storage ----------------------------------------------------------------
# local       = filesystem (sandbox/dev) — served via GET /api/media/{name}
# vercel-blob = Vercel Blob (production; needs BLOB_READ_WRITE_TOKEN, which
#               Vercel injects automatically when a Blob store is linked)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# --- Scheduler --------------------------------------------------------------
# Publishing is driven by an external cron ping (e.g. cron-job.org, 1 min):
#   GET {PUBLIC_APP_URL}/api/cron/publish?key=<CRON_SECRET>
# When set, requests without the matching key get 401. Unset = open (dev).
CRON_SECRET=""

# --- AI ---------------------------------------------------------------------
# Z.ai (GLM) API key — server side only, never expose to the client.
# When set, AI runs against https://api.z.ai/api/paas/v4 (OpenAI-compatible).
# Override the endpoint with ZAI_BASE_URL if needed.
# When unset (sandbox/dev), the local .z-ai-config file is used.
ZAI_API_KEY=""
# ZAI_BASE_URL="https://api.z.ai/api/paas/v4"
# AI_MODEL="glm-4.6"  # any OpenAI-compatible model, e.g. gemini-2.0-flash
#                     # (pair with ZAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai)

# --- Sandbox service launcher (development only, never set in production) ---
SANDBOX_SVC=0

# --- Meta: Facebook Login for Business configuration ------------------------
# New-style Meta apps (use-cases flow) grant business permissions ONLY through
# a login Configuration. Create one in Meta dashboard → Facebook Login for
# Business → Configurations, then paste its ID here (optional per-platform
# override; the shared var applies to both FACEBOOK and INSTAGRAM).
META_LOGIN_CONFIG_ID=""
# META_FB_LOGIN_CONFIG_ID=""
# META_IG_LOGIN_CONFIG_ID=""
