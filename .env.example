# ---------------------------------------------------------------------------
# SMM — AI Social Media Manager
# Copy to `.env` and fill in real values. Never commit the filled file.
# ---------------------------------------------------------------------------

# --- Database (Neon PostgreSQL, pooled connection recommended) --------------
# Prisma reads POSTGRES_URL.
POSTGRES_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth -------------------------------------------------------------------
# 64+ random chars. Generate: openssl rand -base64 48
APP_JWT_SECRET="change-me-to-a-long-random-string"

# --- Encryption -------------------------------------------------------------
# AES-256-GCM key for OAuth tokens at rest (base64 or hex, 32 bytes).
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY="change-me-32-bytes-base64"

# --- Queue ------------------------------------------------------------------
# db    = Postgres-backed queue (zero infra, dev friendly)
# redis = BullMQ (recommended for production)
QUEUE_DRIVER=db
REDIS_URL="redis://default:password@host:6379"

# --- Storage ----------------------------------------------------------------
# local = filesystem (sandbox/dev); s3 = S3-compatible (production)
STORAGE_DRIVER=local
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Platform OAuth apps (from Meta / Pinterest developers portals) ---------
# Facebook Pages: pages_show_list, pages_manage_posts, pages_read_engagement,
#                 pages_manage_engagement
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Instagram Professional: instagram_basic, instagram_content_publish,
#                         instagram_manage_comments, business_management
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# Pinterest API v5: boards:read, pins:read, pins:write,
#                   user_account:read (analytics: user_account:supported)
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""

# OAuth redirect URI pattern:
#   {API_BASE}/api/v1/accounts/oauth/{platform}/callback

# --- AI ---------------------------------------------------------------------
# Z.ai credentials (GLM) — server side only, never expose to the client.
ZAI_API_KEY=""
# Optional explicit base URL override
# ZAI_BASE_URL=""

# --- Sandbox service launcher (development only, never set in production) ---
SANDBOX_SVC=0
